# Copy into .env.local and fill the public web app values from Firebase Console.
# These identify the web app; NEVER put an Admin private key in NEXT_PUBLIC_*.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Backend gateway reached by the Next.js server.
API_GATEWAY_URL=http://localhost:8080
